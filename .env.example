# =============================================================================
# AARDVARK PLATFORM - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=Aardvark
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# -----------------------------------------------------------------------------
# Database - PostgreSQL
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://aardvark:aardvark_dev_password@localhost:5432/aardvark

# Connection pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Cache - Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Session settings
SESSION_SECRET=your_session_secret_here_change_in_production
SESSION_MAX_AGE=604800000

# -----------------------------------------------------------------------------
# Search - Elasticsearch
# -----------------------------------------------------------------------------
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# -----------------------------------------------------------------------------
# File Storage - S3 Compatible (AWS S3 or MinIO)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=aardvark_minio
S3_SECRET_KEY=aardvark_minio_secret
S3_BUCKET=aardvark-uploads
S3_CDN_URL=

# For AWS S3, use:
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Authentication - JWT
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# -----------------------------------------------------------------------------
# Email - SMTP
# -----------------------------------------------------------------------------
# Development: Use MailHog (localhost:1025)
# Production: Use SendGrid, AWS SES, or other SMTP provider
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Aardvark
SMTP_FROM_EMAIL=noreply@aardvark.local

# SendGrid (alternative)
SENDGRID_API_KEY=

# -----------------------------------------------------------------------------
# Payment - Stripe
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_xxxxx
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_xxxxx
STRIPE_CREDITS_100_PRICE_ID=price_xxxxx
STRIPE_CREDITS_500_PRICE_ID=price_xxxxx
STRIPE_CREDITS_1000_PRICE_ID=price_xxxxx

# -----------------------------------------------------------------------------
# Ads - Google AdSense/AdMob
# -----------------------------------------------------------------------------
GOOGLE_AD_CLIENT=ca-pub-your_publisher_id
GOOGLE_AD_SLOT_BANNER=your_banner_slot_id
GOOGLE_AD_SLOT_VIDEO=your_video_slot_id

# -----------------------------------------------------------------------------
# AI - OpenAI (for AI Writing Companion)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2000

# Alternative: Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
MIXPANEL_TOKEN=your_mixpanel_token

# -----------------------------------------------------------------------------
# Error Tracking - Sentry
# -----------------------------------------------------------------------------
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# -----------------------------------------------------------------------------
# Content Moderation - AWS Comprehend (optional)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_NSFW_CONTENT=false
FEATURE_AI_COMPANION=true
FEATURE_PREMIUM_SUBSCRIPTIONS=true
FEATURE_AD_REWARDS=true
FEATURE_FORUM=true
FEATURE_MESSAGING=true

# -----------------------------------------------------------------------------
# Development
# -----------------------------------------------------------------------------
DEBUG=false
LOG_LEVEL=info

# Hot reload for development
WATCHPACK_POLLING=true
